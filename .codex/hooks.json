{
  "description": "구조도 작업: 검증된 변경만 로컬 자동 커밋, 세션 인계 메모. push하지 않음. + 컨텍스트 보호(큰 DB 통독 차단·사용률 알림·기출 DB 인계).",
  "hooks": {
    "PreToolUse": [{"matcher": "Bash|shell|local_shell", "hooks": [{
      "type": "command",
      "command": "python3 \"$(git rev-parse --show-toplevel)/tools/ctx_guard.py\" pretool",
      "commandWindows": "powershell.exe -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) 'tools/ctx_guard.py') pretool\"",
      "timeout": 10
    }]}],
    "UserPromptSubmit": [{"hooks": [{
      "type": "command",
      "command": "python3 \"$(git rev-parse --show-toplevel)/tools/ctx_guard.py\" prompt",
      "commandWindows": "powershell.exe -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) 'tools/ctx_guard.py') prompt\"",
      "timeout": 10
    }]}],
    "Stop": [{"hooks": [{
      "type": "command",
      "command": "python3 \"$(git rev-parse --show-toplevel)/tools/study_harness.py\" stop",
      "commandWindows": "powershell.exe -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) 'tools/study_harness.py') stop\"",
      "timeout": 30,
      "statusMessage": "검증된 구조도 변경을 로컬 커밋"
    }]}],
    "SessionStart": [{"matcher": "startup|resume|clear|compact", "hooks": [{
      "type": "command",
      "command": "python3 \"$(git rev-parse --show-toplevel)/tools/study_harness.py\" resume",
      "commandWindows": "powershell.exe -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) 'tools/study_harness.py') resume\"",
      "timeout": 10,
      "additionalContextLimit": 2000
    }, {
      "type": "command",
      "command": "python3 \"$(git rev-parse --show-toplevel)/tools/ctx_guard.py\" resume",
      "commandWindows": "powershell.exe -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) 'tools/ctx_guard.py') resume\"",
      "timeout": 10,
      "additionalContextLimit": 1500
    }]}],
    "PreCompact": [{"hooks": [{
      "type": "command",
      "command": "python3 \"$(git rev-parse --show-toplevel)/tools/study_harness.py\" checkpoint",
      "commandWindows": "powershell.exe -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) 'tools/study_harness.py') checkpoint\"",
      "timeout": 10,
      "statusMessage": "구조도 인계 체크포인트 저장"
    }, {
      "type": "command",
      "command": "python3 \"$(git rev-parse --show-toplevel)/tools/ctx_guard.py\" precompact",
      "commandWindows": "powershell.exe -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) 'tools/ctx_guard.py') precompact\"",
      "timeout": 10
    }]}]
  }
}
